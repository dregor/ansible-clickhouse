<?xml version="1.0"?>
{{ ansible_managed | comment('xml') }}
<clickhouse>
  <remote_servers>
{% for cluster_name, cluster in clickhouse_clusters.items() %}
    <{{ cluster_name }}>
{% if clickhouse_distributed_secret is defined %}
        <secret>{{ clickhouse_distributed_secret }}</secret>
{% endif %}
{% for shard in cluster %}
        <shard>
          <internal_replication>true</internal_replication>
{% for replica in shard %}
          <replica>
            <host>{{ replica['host'] }}</host>
            <port>{{ replica['port'] | default(9000) }}</port>
{% if 'secure' in replica %}
            <secure>1</secure>
{% endif %}
            {% if clickhouse_replication_user: %}
              <user>{{ clickhouse_replication_user }}</user>
              <password>{{ clickhouse_replication_password }}</password>
            {% endif %}
          </replica>
{% endfor %}
        </shard>
{% endfor %}
    </{{ cluster_name }}>
{% endfor %}
  </remote_servers>
</clickhouse>
